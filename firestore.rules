rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'akundatakantor@gmail.com' ||
        request.auth.uid == 'DlLbVt5MZLR4iEqt2eIYaSiJ0ro2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Student Validation
    function isValidStudent(data) {
      return data.keys().hasAll(['name', 'enrollmentDate', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.enrollmentDate is timestamp &&
             data.createdAt is timestamp &&
             (data.get('photoUrl', null) == null || (data.photoUrl is string && data.photoUrl.size() <= 1000000)) &&
             (data.get('vocation', null) == null || (data.vocation is string && data.vocation.size() <= 100)) &&
             (data.get('clusters', null) == null || data.clusters is list) &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    // Activity Validation
    function isValidActivity(data) {
      return data.keys().hasAll(['studentId', 'date', 'category', 'classActivity', 'results', 'attachment', 'createdAt']) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.date is timestamp &&
             data.category is string && data.category.size() > 0 &&
             data.classActivity is string && data.classActivity.size() > 0 && data.classActivity.size() <= 2000 &&
             data.results is string && data.results.size() > 0 &&
             (data.attachment == null || (
               data.attachment is map &&
               data.attachment.keys().hasAll(['name', 'type', 'base64']) &&
               data.attachment.name is string &&
               data.attachment.type is string &&
               data.attachment.base64 is string &&
               data.attachment.base64.size() <= 1000000 &&
               (data.attachment.get('driveFileId', null) == null || data.attachment.driveFileId is string) &&
               (data.attachment.get('driveViewLink', null) == null || data.attachment.driveViewLink is string)
             )) &&
             (data.get('attachments', null) == null || (
               data.attachments is list
             )) &&
             data.createdAt is timestamp &&
             (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStudent(incoming());
      allow update: if isSignedIn() && isValidStudent(incoming()) && 
                    incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn();
    }

    match /students/{studentId}/activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidActivity(incoming()) && (incoming().studentId == studentId);
      allow update: if isSignedIn() && isValidActivity(incoming()) && 
                    (incoming().studentId == studentId) && 
                    (incoming().createdAt == existing().createdAt);
      allow delete: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        request.auth.uid == userId && 
        incoming().diff(existing()).affectedKeys().hasOnly(['lastActive', 'forceLogout', 'updatedAt', 'displayName', 'email']) &&
        (incoming().get('forceLogout', false) == false) // Can only set to false or keep as false
      );
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /clusters/{clusterId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /vocations/{vocationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Collection group for dashboard stats
    match /{path=**}/activities/{activityId} {
      allow read: if isSignedIn();
    }
  }
}
