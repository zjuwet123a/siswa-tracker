rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Student Validation
    function isValidStudent(data) {
      return data.keys().hasAll(['name', 'enrollmentDate', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.enrollmentDate is timestamp &&
             data.createdAt is timestamp;
    }

    // Activity Validation
    function isValidActivity(data) {
      return data.keys().hasAll(['studentId', 'date', 'classActivity', 'results', 'createdAt']) &&
             data.studentId is string && 
             data.date is timestamp &&
             data.classActivity is string && data.classActivity.size() > 0 && data.classActivity.size() <= 2000 &&
             data.results is string && data.results.size() > 0 && data.results.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create: if isValidStudent(incoming());
      allow update: if isValidStudent(incoming()) && (incoming().createdAt == resource.data.createdAt);
      allow delete: if true;
    }

    match /students/{studentId}/activities/{activityId} {
      allow read: if true;
      allow create: if isValidActivity(incoming()) && (incoming().studentId == studentId);
      allow update: if isValidActivity(incoming()) && (incoming().studentId == studentId) && (incoming().createdAt == resource.data.createdAt);
      allow delete: if true;
    }

    // Allow collection group queries for activities
    match /{path=**}/activities/{activityId} {
      allow read: if true;
    }
  }
}
