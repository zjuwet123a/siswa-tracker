{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Represents a student in the tracker.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The student's full name" },
        "enrollmentDate": { "type": "string", "format": "date-time", "description": "The date the student joined" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the student was added" }
      },
      "required": ["name", "enrollmentDate", "createdAt"]
    },
    "Activity": {
      "title": "Student Activity",
      "description": "Represents a learning record for a student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "Reference to the student ID" },
        "date": { "type": "string", "format": "date-time", "description": "The date of the learning activity" },
        "classActivity": { "type": "string", "description": "The activity performed in class" },
        "results": { "type": "string", "description": "The results or outcome of the activity" },
        "createdBy": { "type": "string", "description": "ID of the user who created this activity" },
        "createdByName": { "type": "string", "description": "Name of the user who created this activity" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the record was created" }
      },
      "required": ["studentId", "date", "classActivity", "results", "createdAt"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of students."
    },
    "/students/{studentId}/activities/{activityId}": {
      "schema": "Activity",
      "description": "Collection of learning records for a specific student."
    }
  }
}
